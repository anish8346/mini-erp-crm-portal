            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitPrice\": 19200,\n  \"minimumStock\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
